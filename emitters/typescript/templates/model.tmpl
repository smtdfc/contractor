
/**
 * Model: {{.Name}}
 * {{if .Description}}{{.Description}}{{else}}Schema for {{.Name}}{{end}}
 * Model Hash: {{.ModelHash}}
 */
export type {{.Name}}{{if .IsGeneric}}<{{range $i, $p := .TypeParams}}{{if $i}}, {{end}}{{$p}}{{end}}>{{end}} = {
    {{- range .Fields}}
    {{.Name}}{{if .IsOptional}}?{{end}}: {{.Type}};
    {{- end}}
}

export type {{.Name}}Schema{{if .IsGeneric}}<{{range $i, $p := .TypeParams}}{{if $i}}, {{end}}{{$p}}{{end}}>{{end}}= {{.Name}}{{if .IsGeneric}}<{{range $i, $p := .TypeParams}}{{if $i}}, {{end}}{{$p}}{{end}}>{{end}} & {
     __k: "{{.ModelHash}}"
}

export class {{.Name}}Validator implements IValidator {
    static readonly modelHash = "{{.ModelHash}}"

    /**
     * Validates raw data against {{.Name}}Schema
     * @param data - The object to validate
     * @returns Result containing the validated {{.Name}}Schema
     */
    validate(data: any,parent=""): ValidateResult<{{.Name}}Schema> {
        const validator = new Validator();
        
        {{range .Validators}}
        {{- if and .IsArray .IsModel}}
        validator.withArray("{{.Field}}", {{.TypeName}}Validator)
            {{- range .Rules}}.{{.Name}}({{$len := len .Args}}{{if gt $len 0}}{{range $index, $arg := .Args}}{{if $index}}, {{end}}{{$arg}}{{end}}{{end}}){{- end}};

        {{- else if .IsModel}}
        validator.withModel("{{.Field}}", {{.TypeName}}Validator)
            {{- range .Rules}}.{{.Name}}({{$len := len .Args}}{{if gt $len 0}}{{range $index, $arg := .Args}}{{if $index}}, {{end}}{{$arg}}{{end}}{{end}}){{- end}};
        
        {{- else if .IsGenericType}}
        validator.withGeneric("{{.Field}}", data.{{.Field}})
            {{- range .Rules}}.{{.Name}}({{$len := len .Args}}{{if gt $len 0}}{{range $index, $arg := .Args}}{{if $index}}, {{end}}{{$arg}}{{end}}{{end}}){{- end}};
 
        {{- else if .Rules}}
        validator.key("{{.Field}}")
            {{- range .Rules}}
            .{{.Name}}({{$len := len .Args}}{{if gt $len 0}}{{range $index, $arg := .Args}}{{if $index}}, {{end}}{{$arg}}{{end}}{{end}})
            {{- end}};
        {{- end}}
        {{- end}}
        
        return validator.execute(data, parent); 
    }
}

registerValidator("{{.ModelHash}}", {{.Name}}Validator);

{{if .IsGeneric}}
export type {{.Name}}GenericMappers<{{range $i, $p := .TypeParams}}{{if $i}}, {{end}}{{$p}}{{end}}> = {
    {{- range .TypeParams}}
    {{.}}: (value: any, path?: string) => {{.}};
    {{- end}}
}
{{end}}

export class {{.Name}}Mapper {
    static from{{if .IsGeneric}}<{{range $i, $p := .TypeParams}}{{if $i}}, {{end}}{{$p}}{{end}}>{{end}}(
        data: any{{if .IsGeneric}},
        genericMappers: {{.Name}}GenericMappers<{{range $i, $p := .TypeParams}}{{if $i}}, {{end}}{{$p}}{{end}}>{{end}}
    ): {{.Name}}Schema{{if .IsGeneric}}<{{range $i, $p := .TypeParams}}{{if $i}}, {{end}}{{$p}}{{end}}>{{end}} {
        const source = (data ?? {}) as Record<string, any>;

        return {
            __k: "{{.ModelHash}}",
            {{- range .Fields}}
            {{- if .IsArray}}
                {{- if .ArrayModelTypeName}}
            {{.Name}}: Array.isArray(source.{{.Name}}) ? source.{{.Name}}.map((item: any) => item == null ? item : {{.ArrayModelTypeName}}Mapper.from(item)) : source.{{.Name}},
                {{- else if .ArrayGenericTypeName}}
            {{.Name}}: Array.isArray(source.{{.Name}}) ? source.{{.Name}}.map((item: any, index: number) => genericMappers.{{.ArrayGenericTypeName}}(item, "{{.Name}}." + index)) : source.{{.Name}},
                {{- else}}
            {{.Name}}: source.{{.Name}},
                {{- end}}
            {{- else if .IsModel}}
            {{.Name}}: source.{{.Name}} == null ? source.{{.Name}} : {{.ModelTypeName}}Mapper.from(source.{{.Name}}),
            {{- else if .IsGeneric}}
            {{.Name}}: genericMappers.{{.GenericTypeName}}(source.{{.Name}}, "{{.Name}}"),
            {{- else}}
            {{.Name}}: source.{{.Name}},
            {{- end}}
            {{- end}}
        };
    }
}
