{{if .IsGeneric}}
func (m *{{.Name}}[{{range $i, $p := .TypeParams}}{{if $i}}, {{end}}{{$p}}{{end}}]) GetMetdata() *core.ModelReflectionMetadata[{{.Name}}[{{range $i, $p := .TypeParams}}{{if $i}}, {{end}}{{$p}} {{end}}]] {
